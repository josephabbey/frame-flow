  "dependencies": {
    "google-auth-library": "^10.2.1",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "bun-types": "^1.4.4",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.2",
    "typescript": "^5.9.3"
  }
}
