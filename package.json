{
  "name": "frame-flow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot api/server.ts",
    "build": "bun build ./index.html --outdir=dist",
    "vercel-build": "bun run build",
    "lint": "bunx eslint src api",
